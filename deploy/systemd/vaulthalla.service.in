[Unit]
Description=Vaulthalla Service - The Final Cloud
After=network.target postgresql.service vaulthalla-swtpm.service
Requires=postgresql.service
Wants=vaulthalla-swtpm.service

[Service]
User=vaulthalla
Group=vaulthalla
SupplementaryGroups=tss
# EnvironmentFile=/etc/vaulthalla/vaulthalla.env
ExecStart=@BINDIR@/vaulthalla-server
ExecStopPost=/bin/sh -c 'if findmnt -rn -M /mnt/vaulthalla >/dev/null 2>&1; then fusermount3 -uz /mnt/vaulthalla 2>/dev/null || fusermount -uz /mnt/vaulthalla 2>/dev/null || umount -l /mnt/vaulthalla 2>/dev/null || true; fi'
Restart=on-failure
RestartSec=3
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
LimitNOFILE=65535
SyslogIdentifier=vaulthalla
WorkingDirectory=/var/lib/vaulthalla

[Install]
WantedBy=multi-user.target
