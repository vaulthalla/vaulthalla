[Unit]
Description=Vaulthalla Service - The Final Cloud
After=network.target postgresql.service vaulthalla-swtpm.service
# Wants (not Requires): remote-DB hosts have no local PostgreSQL, and a PostgreSQL
# restart must not stop the FUSE daemon underneath its clients.
Wants=postgresql.service vaulthalla-swtpm.service
# Give up after 10 failed starts within 10 minutes (e.g. missing DB credential or TPM)
# instead of restarting forever; `systemctl reset-failed vaulthalla` re-arms it.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
User=vaulthalla
Group=vaulthalla
SupplementaryGroups=tss
# EnvironmentFile=/etc/vaulthalla/vaulthalla.env
ExecStart=@BINDIR@/vaulthalla-server
ExecStopPost=/bin/sh -c 'if findmnt -rn -M /mnt/vaulthalla >/dev/null 2>&1; then fusermount3 -uz /mnt/vaulthalla 2>/dev/null || fusermount -uz /mnt/vaulthalla 2>/dev/null || umount -l /mnt/vaulthalla 2>/dev/null || true; fi'
Restart=on-failure
RestartSec=10
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
LimitNOFILE=65535
# No core dumps: the daemon holds vault keys and transient plaintext (previews, media ranges) in memory, and it
# also makes itself non-dumpable (main.cpp), because a dump would wait on threads blocked on its own FUSE mount and
# never finish; a crash instead exits at once and Restart=on-failure brings it back.
# Mount-namespace hardening (PrivateTmp, ProtectSystem, ProtectHome) would hide the FUSE mount from the host, and
# NoNewPrivileges would break the setuid fusermount3 the mount relies on; hostile-file parsers instead run in the
# separately sandboxed helper processes (preview::derive).
LimitCORE=0
SyslogIdentifier=vaulthalla
WorkingDirectory=/var/lib/vaulthalla

[Install]
WantedBy=multi-user.target
