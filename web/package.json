{
  "name": "vaulthalla-web",
  "version": "1.6.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:e2e": "NEXT_PUBLIC_VAULTHALLA_WS_ORIGIN=${NEXT_PUBLIC_VAULTHALLA_WS_ORIGIN:-ws://127.0.0.1:36969} VAULTHALLA_AUTH_ORIGIN=${VAULTHALLA_AUTH_ORIGIN:-http://127.0.0.1:36970} VAULTHALLA_PREVIEW_ORIGIN=${VAULTHALLA_PREVIEW_ORIGIN:-http://127.0.0.1:36970} VAULTHALLA_WEB_DEV_MODE=${VAULTHALLA_WEB_DEV_MODE:-true} next dev --turbopack --hostname ${VAULTHALLA_E2E_WEB_HOST:-127.0.0.1} --port ${VAULTHALLA_E2E_WEB_PORT:-3000}",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "pnpm run typecheck && pnpm run lint",
    "test:e2e": "playwright test",
    "test:e2e:s3-gateway": "playwright test tests/e2e/s3-gateway.spec.ts",
    "playwright:install": "playwright install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "motion": "^12.38.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "tailwind-merge": "^3.5.0",
    "use-debounce": "^10.1.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.0.8"
}
