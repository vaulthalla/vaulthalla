#!/usr/bin/make -f

# Shipped binaries: -O3 with Debian's hardening flags (FORTIFY_SOURCE, stack protector, PIE, relro/bindnow) and
# debug info for the dbgsym package. The optimization level is explicit: dpkg's -O2 is stripped and meson's
# optimization=3 supplies -O3. No LTO. Warnings fail the build, as in development (-Werror).
# Release CI checks the resulting compile lines (tools/dev/check_build_flags.py).
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
export DEB_CXXFLAGS_MAINT_STRIP = -O2

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Doptimization=3 -Dwerror=true -Dmanpage=true

override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade

# Meson installs the TPM udev rule as 60-vaulthalla-tpm.rules; letting dh_installudev
# also install it as 60-vaulthalla.rules would ship the same TPM rule twice.
override_dh_installudev:

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

	# Stage packaging payloads that are still assembled outside Meson.
	install -d debian/tmp/usr/share/vaulthalla-web

	@if [ ! -d web/.next/standalone ]; then \
		echo "Missing web/.next/standalone. Run web production build before Debian packaging."; \
		exit 1; \
	fi
	@if [ ! -d web/.next/static ]; then \
		echo "Missing web/.next/static. Run web production build before Debian packaging."; \
		exit 1; \
	fi
	cp -a web/.next/standalone/. debian/tmp/usr/share/vaulthalla-web/
	install -d debian/tmp/usr/share/vaulthalla-web/.next
	cp -a web/.next/static debian/tmp/usr/share/vaulthalla-web/.next/
	if [ -d web/public ]; then cp -a web/public debian/tmp/usr/share/vaulthalla-web/; fi
