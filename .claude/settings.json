{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(meson compile:*)",
      "Bash(meson test:*)",
      "Bash(meson introspect:*)",
      "Bash(ninja -C build:*)",
      "Bash(pnpm --dir web typecheck)",
      "Bash(pnpm --dir web lint)",
      "Bash(vlr check:*)",
      "Bash(vlr status:*)",
      "Bash(vlr version check)",
      "Bash(vlr prepare --dry-run)",
      "Bash(vlr release-title --staged)",
      "Bash(vlr release-body --staged)",
      "Bash(python3 -m unittest:*)",
      "Bash(bash tools/dev/verify.sh:*)",
      "Bash(bash .claude/skills/lab/scripts/inspect.sh:*)",
      "Bash(pmdocs validate:*)"
    ],
    "deny": [
      "Bash(pkill -f:*)",
      "Bash(pkill -9 -f:*)",
      "Bash(pgrep -f vaulthalla:*)",
      "Bash(killall:*)",
      "Bash(fuser -k:*)",
      "Bash(fuser -km:*)",
      "Read(./deploy/vaulthalla.env)",
      "Read(./deploy/bashrc)",
      "Read(./.bashrc)",
      "Read(./cloudflare.ini)"
    ]
  }
}
